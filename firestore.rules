rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /dayflowUsers/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validState() {
        return request.resource.data.keys().hasAll(['state', 'revision'])
          && request.resource.data.keys().hasOnly(['state', 'revision'])
          && request.resource.data.state is string
          && request.resource.data.revision is int;
      }
      allow get: if isOwner();
      allow create: if isOwner() && validState() && request.resource.data.revision == 1;
      allow update: if isOwner() && validState()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
